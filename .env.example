# Database
DATABASE_URL="file:./dev.db" # or "postgresql://user:password@localhost:5432/kahvipanda"

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Authentication
JWT_SECRET=""
SESSION_SECRET="replace_with_a_secure_session_secret"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Database seeding (seed.ts deletes existing store data; enable only for a deliberate reset)
SEED_RESET="false"

# OpenAI for Panda AI (Leave blank for autonomous intelligent mock concierge)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# WhatsApp Business API (Leave blank for instant https://wa.me/919874199454 fallback)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_TARGET_PHONE="919874199454"

# Razorpay Payments (Leave blank for safe simulated test checkout mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
